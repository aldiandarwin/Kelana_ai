# Copy this file to .env and fill in your local PostgreSQL password.
# .env is gitignored and must never be committed.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/kelana_ai

# Session 5: Amazon Bedrock. The API key is handed out by the instructor in class.
# Paste it into .env only. Never into chat, terminal history, or a screenshot.
AWS_BEARER_TOKEN_BEDROCK=YOUR_BEDROCK_API_KEY
AWS_REGION=ap-southeast-2
MODEL_ID=amazon.nova-lite-v1:0

# Session 7: browser origin allowed by FastAPI CORS.
FRONTEND_URL=http://localhost:3000

# Session 8: sign JWT access tokens. Generate a unique random value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Session 9: retrieval. The embedding model is optional and defaults to
# amazon.titan-embed-text-v2:0, which the class Bedrock API key can call because
# InvokeModel is an Amazon Bedrock Runtime action.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Session 9, managed path. Leave all three empty to retrieve from the local
# vector store in PostgreSQL, which is what the class API key supports.
# Fill them in only with real IAM credentials: an Amazon Bedrock API key cannot
# call Agents for Amazon Bedrock or Amazon S3. See
# docs.aws.amazon.com/bedrock/latest/userguide/api-keys-use.html
KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_DATA_SOURCE_ID=
S3_KNOWLEDGE_BUCKET=
